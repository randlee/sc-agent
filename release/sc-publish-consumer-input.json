{
  "schema_version": 1,
  "project": {
    "name": "sc-agent",
    "archive_prefix": "sc-agent",
    "description": "TypeSafe decision client (decidr), sitr tree-sitter CLI, workspace crates, and Python bindings for Synaptic Canvas agents",
    "homepage": "https://github.com/randlee/sc-agent",
    "license": "MIT",
    "workspace_toml": "Cargo.toml",
    "rust_toolchain": "1.99.0",
    "renderer_archive_path": "bin/decidr",
    "readme_dependency_crate": "decidr"
  },
  "release_targets": [
    {
      "target": "x86_64-unknown-linux-gnu",
      "os": "ubuntu-latest",
      "archive": "tar.gz"
    },
    {
      "target": "aarch64-unknown-linux-gnu",
      "os": "ubuntu-24.04-arm",
      "archive": "tar.gz"
    },
    {
      "target": "x86_64-apple-darwin",
      "os": "macos-latest",
      "archive": "tar.gz"
    },
    {
      "target": "aarch64-apple-darwin",
      "os": "macos-latest",
      "archive": "tar.gz"
    },
    {
      "target": "x86_64-pc-windows-msvc",
      "os": "windows-latest",
      "archive": "zip"
    }
  ],
  "crates": [
    {
      "artifact": "sc-agent",
      "package": "sc-agent",
      "cargo_toml": "crates/sc-agent/Cargo.toml",
      "publish": true,
      "publish_order": 1,
      "wait_after_publish_seconds": 0,
      "verify_registry_visibility": true
    },
    {
      "artifact": "sc-treesitter",
      "package": "sc-treesitter",
      "cargo_toml": "crates/sc-treesitter/Cargo.toml",
      "publish": true,
      "publish_order": 2,
      "wait_after_publish_seconds": 0,
      "verify_registry_visibility": true
    },
    {
      "artifact": "sitr",
      "package": "sitr",
      "cargo_toml": "crates/sitr/Cargo.toml",
      "publish": true,
      "publish_order": 3,
      "wait_after_publish_seconds": 0,
      "verify_registry_visibility": true
    },
    {
      "artifact": "decidr",
      "package": "decidr",
      "cargo_toml": "crates/decidr/Cargo.toml",
      "publish": true,
      "publish_order": 4,
      "wait_after_publish_seconds": 0,
      "verify_registry_visibility": true
    },
    {
      "artifact": "sc-agent-py",
      "package": "sc-agent-py",
      "cargo_toml": "crates/sc-agent-py/Cargo.toml",
      "publish": false,
      "publish_order": 0,
      "wait_after_publish_seconds": 0,
      "verify_registry_visibility": false
    }
  ],
  "release_binaries": [
    {
      "name": "decidr",
      "bundled_paths": [
        {
          "source": "site/cli/decidr",
          "destination": "docs/decidr",
          "homebrew_destination_components": [
            "pkgshare",
            "docs",
            "decidr"
          ]
        }
      ]
    },
    {
      "name": "sitr",
      "bundled_paths": [
        {
          "source": "site/cli/sitr",
          "destination": "docs/sitr",
          "homebrew_destination_components": [
            "pkgshare",
            "docs",
            "sitr"
          ]
        }
      ]
    }
  ],
  "python_packages": [
    {
      "artifact": "sc-agent-py-wheel",
      "package": "sc-decidr",
      "manifest": "crates/sc-agent-py/pyproject.toml",
      "module": "sc_agent",
      "publish": "pypi"
    }
  ],
  "python_distributions": [
    {
      "name": "sc-decidr",
      "source": "crates/sc-agent-py",
      "cargo_manifest": "crates/sc-agent-py/Cargo.toml",
      "module_path": "crates/sc-agent-py",
      "sdist": true,
      "wheels": [
        {
          "id": "linux-x86_64",
          "os": "ubuntu-latest",
          "target": "x86_64-unknown-linux-gnu",
          "platform": "manylinux_2_28_x86_64",
          "manylinux": "2_28"
        },
        {
          "id": "linux-arm64",
          "os": "ubuntu-latest",
          "target": "aarch64-unknown-linux-gnu",
          "platform": "manylinux_2_28_aarch64",
          "manylinux": "2_28"
        },
        {
          "id": "macos-arm64",
          "os": "macos-latest",
          "target": "aarch64-apple-darwin",
          "platform": "macosx_11_0_arm64",
          "deployment_target": "11.0"
        },
        {
          "id": "macos-x86_64",
          "os": "macos-latest",
          "target": "x86_64-apple-darwin",
          "platform": "macosx_11_0_x86_64",
          "deployment_target": "11.0"
        },
        {
          "id": "windows-x86_64",
          "os": "windows-latest",
          "target": "x86_64-pc-windows-msvc",
          "platform": "win_amd64"
        },
        {
          "id": "windows-arm64",
          "os": "windows-11-arm",
          "target": "aarch64-pc-windows-msvc",
          "platform": "win_arm64"
        }
      ]
    }
  ],
  "npm_packages": [],
  "channels": {
    "pypi": {
      "workflow": "pypi-publish.yml",
      "dispatch_inputs": {
        "target": "production"
      },
      "credential_rehearsal_inputs": {
        "target": "testpypi"
      },
      "test_repository": "testpypi",
      "production_repository": "pypi"
    },
    "homebrew": {
      "workflow": "homebrew-publish.yml",
      "dispatch_inputs": {},
      "tap_repository": "randlee/homebrew-tap",
      "renderer_target": "x86_64-unknown-linux-gnu",
      "formulas": [
        {
          "path": "Formula/decidr.rb",
          "template": "release/homebrew/formula.rb.j2",
          "class": "Decidr",
          "binaries": [
            "decidr",
            "sitr"
          ],
          "test_binary": "decidr",
          "test_command": "--version",
          "test_output": "decidr",
          "release_track": "stable"
        }
      ],
      "assets": [
        {
          "key": "macos_arm",
          "target": "aarch64-apple-darwin"
        },
        {
          "key": "macos_intel",
          "target": "x86_64-apple-darwin"
        },
        {
          "key": "linux",
          "target": "x86_64-unknown-linux-gnu"
        }
      ]
    },
    "scoop": {
      "workflow": "scoop-publish.yml",
      "dispatch_inputs": {},
      "bucket_repository": "randlee/scoop-bucket",
      "manifest_path": "bucket/decidr.json",
      "manifest_template": "release/scoop/manifest.json.j2",
      "installer_target": "x86_64-pc-windows-msvc",
      "binaries": [
        "decidr",
        "sitr"
      ],
      "renderer_target": "x86_64-unknown-linux-gnu"
    },
    "winget": {
      "workflow": "winget-publish.yml",
      "dispatch_inputs": {},
      "identifier": "randlee.decidr",
      "installer_target": "x86_64-pc-windows-msvc"
    }
  },
  "docli": {
    "enabled": true,
    "generate_script": "scripts/generate-cli-docs.sh",
    "drift_paths": [
      "fixtures/cli/",
      "site/cli/"
    ],
    "description": "CLI reference HTML for decidr and sitr matches the clap command trees"
  },
  "prerelease": {
    "tag_prefix": "prerelease/v",
    "tag_script": "scripts/prerelease_tag.py",
    "install_root": "~/.sc-agent/prerelease",
    "binaries": [
      "decidr",
      "sitr"
    ],
    "protected_branches": [
      "develop",
      "main",
      "integrate/phase-b"
    ],
    "selector_dir": {
      "darwin": "~/.local/bin",
      "linux": "~/.local/bin",
      "windows": "~/.local/bin"
    },
    "post_install": "{python} scripts/install_wheels.py --stage \"{stage_dir}\" {wheels}",
    "verify": "{python} scripts/install_wheels.py --verify --stage \"{stage_dir}\" --version {version}"
  },
  "preflight_checks": [],
  "archive_verification": [
    "bash",
    ".github/scripts/run-consumer-preflight.sh"
  ]
}
