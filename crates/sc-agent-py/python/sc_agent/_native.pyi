"""Types of the native sc_agent._native module (crates/sc-agent-py/src/lib.rs).

Every function returns a result value, never raises: {"ok": True, "value": ...} or
{"ok": False, "error": {"id", "message", "action", "category", ...}}.
The public Run and Logger classes are re-exported by sc_agent.
"""
from collections.abc import Callable, Iterable
from typing import Any, Literal, Self


Envelope = dict[str, Any]
Request = str | dict[str, Any]

def logger(name: str, *, tool: str = "decidr") -> Envelope: ...
def log(logger: Logger, event: dict[str, Any], *, tool: str = "decidr") -> Envelope: ...
def flush(logger: Logger, *, tool: str = "decidr") -> Envelope: ...
def digest(request: dict[str, Any], question: str, *, general_log: Logger | None = None, tool: str = "decidr") -> Envelope: ...
class Logger: ...
class Run:
    def __init__(self, *, tool: str | None = None, model: str | None = None,
                 project: str | None = None, agent_role: str | None = None,
                 config_dir: str | None = None, general_log: Logger | None = None,
                 timeout_secs: float | None = None, workers: int | None = None,
                 base_url: str | None = None, sleep: Callable[[float], object] | None = None,
                 keyring_lookup: Callable[[str], str] | None = None) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, kind: object, value: object, traceback: object) -> Literal[False]: ...
    def sends_to(self, provider: str) -> Envelope: ...
    def cancel(self) -> Envelope: ...
    def send(self, request: Request) -> Envelope: ...
    def send_batch(self, requests: Iterable[Request], *, on_result: Callable[[int, Envelope], object] | None = None) -> Envelope: ...
TYPESAFE: str

def provider_keys() -> Envelope: ...
def models() -> Envelope: ...
def languages(*, general_log: Logger | None = None, tool: str = "sitr") -> Envelope: ...
def queries(language: str, *, general_log: Logger | None = None, tool: str = "sitr") -> Envelope: ...
def query(language: str, source: str, query: str, *, general_log: Logger | None = None, tool: str = "sitr") -> Envelope: ...
def run(language: str, name: str, source: str, *, general_log: Logger | None = None, tool: str = "sitr") -> Envelope: ...
