from typing import Any, Callable
class CancelToken:
    def cancel(self) -> None: ...
    def cancelled(self) -> bool: ...
class SagError(Exception):
    @property
    def id(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def detail(self) -> str: ...
    @property
    def status(self) -> int | None: ...
    @property
    def attempts(self) -> int | None: ...
    @property
    def retry_after_ms(self) -> int | None: ...
    @property
    def category(self) -> str: ...
    @property
    def retryable(self) -> bool: ...
def category(detail: dict | str) -> str: ...
def retryable(detail: dict | str) -> bool: ...
def send(request: str, model: str, project: str, agent_role: str, logger: Any = None, provider: str | None = None, cancel: CancelToken | None = None, *, general_log: Any = None, session_log: Any = None, abort_on: list[str] = [], keyring_service: str | None = None, keyring_account: str | None = None) -> str: ...
def send_batch(requests: list[str], model: str, project: str, agent_role: str, logger: Any = None, provider: str | None = None, workers: int = 8, cancel: CancelToken | None = None, *, general_log: Any = None, session_log: Any = None, abort_on: list[str] = [], keyring_service: str | None = None, keyring_account: str | None = None) -> list[str]: ...
def client_logger(name: str) -> Any: ...
