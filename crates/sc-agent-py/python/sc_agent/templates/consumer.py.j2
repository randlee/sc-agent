# Generated by sc-decidr {{ sc_decidr_version }}; Python >=3.11.
"""Shared client for the released sc-decidr {{ sc_decidr_version }} Python API.

The module imports without the optional wheel; the wheel is loaded only when a call needs it.
Nothing here raises: every failure is returned as a value.
Template inputs: client_name (str) supplies the logger/session role and default
consent-module prefix; sitr (bool) includes the optional extract function.
The consent block supplies the default settings-module policy; consumers may
override that named block without changing decision or batch processing.
"""
from __future__ import annotations

import importlib
import json
import math
import pathlib
import re
import sys
from collections.abc import Callable, Mapping, Sequence
from dataclasses import dataclass, field
from typing import Any, Generic, Literal, NamedTuple, TypeGuard, TypeVar, cast

SC_DECIDR_VERSION = "{{ sc_decidr_version }}"
CLIENT_NAME = "{{ client_name }}"
TOOL_VERSION = "{{ tool_version }}"
Record = dict[str, Any]

DECIDR_CATEGORY_CODES = {
    "auth": "AUTH.CREDENTIALS", "quota": "DECIDR.RATE_LIMITED", "busy": "DECIDR.OVERLOADED",
    "network": "DECIDR.NETWORK", "response_invalid": "DECIDR.RESPONSE_INVALID",
    "validation": "DECIDR.VALIDATION", "cancelled": "CANCELED",
    "config": "DECIDR.CONFIG", "log": "DECIDR.LOG", "other": "DECIDR.ERROR",
    "context_exceeded": "DECIDR.CONTEXT_EXCEEDED",
}
_ALLOWED_ABORT_ON = (frozenset[str](), frozenset({"auth"}), frozenset({"auth", "quota"}))


T = TypeVar("T")
E = TypeVar("E")

@dataclass(frozen=True)
class Ok(Generic[T]):
    value: T
    ok: Literal[True] = field(default=True, init=False)

@dataclass(frozen=True)
class Err(Generic[E]):
    error: E
    ok: Literal[False] = field(default=False, init=False)

Result = Ok[T] | Err[E]

@dataclass(frozen=True)
class ToolError:
    code: str
    message: str
    action: str | None = None
    data: Any = None

    def to_json(self) -> dict[str, Any]:
        return {"code": self.code, "message": self.message, "recoverable": False, "suggested_action": self.action}

def err(code: str, message: str, action: str | None = None, data: Any = None) -> Err[ToolError]:
    return Err(ToolError(code, message, action, data))

def utf8_stdio() -> None:
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        reconfigure: Any = getattr(stream, "reconfigure", None)
        if reconfigure is not None:
            try:
                reconfigure(encoding="utf-8")
            except (ValueError, OSError):
                pass

def run_main(main: Callable[[], int]) -> int:
    try:
        utf8_stdio()
        return main()
    except KeyboardInterrupt:
        try:
            write_stdout_line(json.dumps(canceled_envelope(), ensure_ascii=False) + "\n")
        except (OSError, ValueError):
            pass
        return CANCELED_EXIT

@dataclass(frozen=True)
class Reply:
    answers: Mapping[str, Any]
    session_id: str | None
    cached: bool


class ClientError(RuntimeError):
    """The shared error for wheel failures and consumer validation/usage errors."""

    def __init__(self, code: str, message: str, retryable: bool = False, action: str | None = None, *,
                 status: int | None = None, retry_after_ms: int | None = None, attempts: int | None = None,
                 data: Any = None) -> None:
        super().__init__(code, message)
        self.code, self.message, self.retryable, self.action = code, message, retryable, action
        self.status, self.retry_after_ms, self.attempts, self.data = status, retry_after_ms, attempts, data

    def __str__(self) -> str:
        return self.message

    def to_json(self) -> Record:
        return {"success": False, "data": self.data,
                "error": {"code": self.code, "message": self.message, "recoverable": self.retryable,
                          "suggested_action": self.action}}


def from_tool_error(error: Any) -> ClientError:
    """A consumer Result error (a ClientError, or a ToolError with code, message, action, data) as a ClientError."""
    if isinstance(error, ClientError):
        return error
    fields = cast(Record, error) if isinstance(error, dict) else {
        key: getattr(error, key, None) for key in ("code", "message", "action", "data")}
    code, message = fields.get("code", fields.get("id")), fields.get("message")
    data = fields.get("data")
    return ClientError(code if isinstance(code, str) else "DECIDR.ERROR",
                       message if isinstance(message, str) else "Unknown tool error",
                       action=fields.get("action"), data=dict(cast(Mapping[str, Any], data)) if isinstance(data, Mapping) else None)


CANCELED_EXIT = 130


def canceled_envelope() -> Record:
    out = ClientError("CANCELED", "interrupted before the command finished", True,
                      "Rerun the command; nothing partial was reported as complete.").to_json()
    out.update(canceled=True, aborted_by="user")
    return out


class NoulAnswer(NamedTuple):
    noul: float


class ChoiceAnswer(NamedTuple):
    choice: str
    confidence: float
    probabilities: Mapping[str, float]


class ScoreAnswer(NamedTuple):
    score: float
    confidence: float
    legend: Mapping[str, Any]
    probabilities: Mapping[str, float]


class BoxAnswer(NamedTuple):
    top: float
    bottom: float
    left: float
    right: float
    confidence: float | None


def typed_answer(answer: Any) -> Any:
    """A JSON answer object as its typed answer; anything else, malformed objects included, unchanged."""
    if not isinstance(answer, dict):
        return answer
    wire = cast(Record, answer)
    kind = wire.get("type") or next((key for key in ("noul", "choice", "score", "box") if key in wire), None)
    try:
        match kind:
            case "noul":
                return NoulAnswer(wire["noul"])
            case "choice":
                return ChoiceAnswer(wire["choice"], wire["confidence"], wire["probabilities"])
            case "score":
                return ScoreAnswer(wire["score"], wire["confidence"], wire["legend"], wire["probabilities"])
            case "box":
                box = wire["box"]
                return BoxAnswer(box["top"], box["bottom"], box["left"], box["right"], wire.get("confidence"))
            case _:
                pass
    except (KeyError, TypeError):
        pass
    return wire


def load_wheel() -> Result[Any, ClientError]:
    try:
        import sc_agent
        return Ok(sc_agent)
    except ImportError as exc:
        return Err(ClientError("DEPENDENCY.SC_DECIDR", str(exc), action="Install sc-decidr in the active Python environment."))


def open_run(*, model: str | None = None, project: str | None = None, cache: bool | None = None,
             config_dir: str | None = None, timeout_secs: float | None = None,
             workers: int | None = None, seams: Mapping[str, Any] | None = None) -> Result[Any, ClientError]:
    wheel = load_wheel()
    if isinstance(wheel, Err):
        return wheel
    return Ok(wheel.value.Run(tool=CLIENT_NAME, tool_version=TOOL_VERSION, agent_role=CLIENT_NAME,
                              model=model, project=project, cache=cache, config_dir=config_dir,
                              timeout_secs=timeout_secs, workers=workers, **(seams or {})))


def wheel_error(detail: Record, *, category_codes: Mapping[str, str] | None = None) -> ClientError:
    """The wheel's error value as a ClientError coded by its category."""
    codes = {**DECIDR_CATEGORY_CODES, **(category_codes or {})}
    identifier, category = detail.get("id"), detail.get("category", "other")
    code = codes.get("context_exceeded" if identifier == "decision.context_exceeded" else category, codes["other"])
    counts = {key: value if type(value := detail.get(key)) is int and value >= 0 else None
              for key in ("status", "retry_after_ms", "attempts")}
    return ClientError(code, detail.get("message", "invalid result"), category in {"busy", "network"},
                       detail.get("action"), **counts, data=dict(detail))


def decode_result(value: str | Mapping[str, Any], *, category_codes: Mapping[str, str] | None = None) -> Result[Reply, ClientError]:
    try:
        envelope: Mapping[str, Any] = json.loads(value) if isinstance(value, str) else value
        if type(envelope.get("ok")) is not bool:
            return _invalid_result("expected an ok/value or ok/error envelope")
        if not envelope["ok"]:
            return Err(wheel_error(envelope["error"], category_codes=category_codes))
        body = envelope["value"]
        return Ok(Reply({key: typed_answer(answer) for key, answer in body["answers"].items()},
                        body.get("session_id"), body.get("cached", False)))
    except (AttributeError, KeyError, TypeError, ValueError) as exc:
        return _invalid_result(exc)


def _invalid_result(reason: object) -> Err[ClientError]:
    return Err(ClientError("DECIDR.INVALID_RESULT", f"sc-decidr returned an invalid result: {reason}",
                           action="Inspect the invalid sc-decidr result and check the wheel and client versions."))


def _abort_if_selected(line: object, abort_on: frozenset[str], run: Any) -> None:
    if isinstance(line, dict):
        detail: Any = cast(dict[str, Any], line).get("error")
        if isinstance(detail, dict) and cast(dict[str, Any], detail).get("category") in abort_on:
            run.cancel()


def _as_text(request: str | Mapping[str, Any]) -> str:
    return request if isinstance(request, str) else json.dumps(request)


def _start(run: Any, abort_on: frozenset[str], category_codes: Mapping[str, str] | None,
           repository_root: str, consent_what: str) -> Result[None, ClientError]:
    try:
        valid = frozenset(abort_on) in _ALLOWED_ABORT_ON
    except (TypeError, ValueError):
        valid = False
    if not valid:
        return Err(ClientError("DECIDR.INVALID_OPTION", "abort_on must be {}, {'auth'}, or {'auth', 'quota'}"))
    wheel = load_wheel()
    if isinstance(wheel, Err):
        return wheel
    target = run.sends_to(wheel.value.TYPESAFE)
    if not target.get("ok"):
        return Err(wheel_error(target.get("error", {}), category_codes=category_codes))
    return remote_judge_consent(repository_root, consent_what) if target.get("value") else Ok(None)


def call_result(run: Any, request: str | Mapping[str, Any], *, cache: bool | None = None,
                abort_on: frozenset[str] = frozenset(), category_codes: Mapping[str, str] | None = None,
                repository_root: str = ".", consent_what: str = "The request text") -> Result[Reply, ClientError]:
    start = _start(run, abort_on, category_codes, repository_root, consent_what)
    if isinstance(start, Err):
        return start
    try:
        line = run.send(_as_text(request), cache=cache)
    except KeyboardInterrupt:
        run.cancel()
        line = {"ok": False, "error": {"id": "decision.cancelled", "category": "cancelled", "message": "interrupted"}}
    except (TypeError, ValueError) as exc:
        return Err(ClientError("DECIDR.INVALID_OPTION", str(exc)))
    _abort_if_selected(line, abort_on, run)
    return decode_result(line, category_codes=category_codes)


def call_batch_results(run: Any, requests: Sequence[str | Mapping[str, Any]], *, cache: bool | None = None,
                       abort_on: frozenset[str] = frozenset(), category_codes: Mapping[str, str] | None = None,
                       repository_root: str = ".", consent_what: str = "The request text") -> Result[list[Result[Reply, ClientError]], ClientError]:
    return _call_batch_results(run, requests, cache=cache, abort_on=abort_on, category_codes=category_codes,
                               repository_root=repository_root, consent_what=consent_what)


def _call_batch_results(run: Any, requests: Sequence[str | Mapping[str, Any]], *, cache: bool | None = None,
                        on_each: Callable[[int, Result[Reply, ClientError]], object] | None = None,
                        abort_on: frozenset[str] = frozenset(), category_codes: Mapping[str, str] | None = None,
                        repository_root: str = ".", consent_what: str = "The request text") -> Result[list[Result[Reply, ClientError]], ClientError]:
    start = _start(run, abort_on, category_codes, repository_root, consent_what)
    if isinstance(start, Err):
        return start
    finished: dict[int, Any] = {}
    def handle(index: int, line: Any) -> None:
        finished[index] = line
        _abort_if_selected(line, abort_on, run)
        if on_each:
            on_each(index, decode_result(line, category_codes=category_codes))
    try:
        batch: Any = run.send_batch([_as_text(request) for request in requests], cache=cache, on_result=handle)
    except KeyboardInterrupt:
        run.cancel()
        batch = {"ok": True, "value": [{"index": i, "result": finished.get(i, {"ok": False, "error": {"id": "decision.cancelled", "category": "cancelled", "message": "interrupted"}})} for i in range(len(requests))]}
    except (TypeError, ValueError) as exc:
        return Err(ClientError("DECIDR.INVALID_OPTION", str(exc)))
    if not batch.get("ok"):
        return Err(wheel_error(batch.get("error", {}), category_codes=category_codes))
    return Ok([decode_result(item["result"], category_codes=category_codes) for item in batch["value"]])


def log_event(run: Any, target: str, action: str, correlation_id: str | None, fields: Mapping[str, Any]) -> Result[None, ClientError]:
    result = run.log({"target": target, "action": action, "correlation_id": correlation_id, "fields": redact_secrets(fields)})
    return Ok(None) if result.get("ok") else Err(wheel_error(result.get("error", {})))


