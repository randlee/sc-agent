BATCH_RESULT_SCHEMA = "jev-batch-result/2"
BATCH_FIXTURE_ERROR = "__error__"

BATCH_ID_RE = r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"


class BatchSettings(NamedTuple):
    gate: str
    repeat: int
    prefix: str
    threshold: float
    dry_run: bool


class BatchJob(NamedTuple):
    item_id: str
    anchor_id: str | None
    candidate_id: str
    repeat: int
    request_id: str
    body: Record
    questions: Record
    roles: Record
    kind: str


class ResultLine(NamedTuple):
    schema: str
    tool: str
    tool_version: str
    run_id: str | None
    session_id: str | None
    request_id: str
    project: str | None
    agent_role: str
    threshold: float
    verdict: str | None
    min_confidence: float | None
    leaning: str | None
    ok: bool
    error: ClientError | None


class StreamedResult(NamedTuple):
    failed: list[ResultLine]


def batch_request_id(prefix: str, item_id: str, anchor_id: str | None, candidate_id: str, repeat: int) -> str:
    if anchor_id is None:
        return f"{prefix}/{item_id}/{candidate_id}/r{repeat}"
    return f"{prefix}/{item_id}/{anchor_id}/{candidate_id}/r{repeat}"


def safe_id(value: object, what: str) -> Result[str, ClientError]:
    if isinstance(value, str) and re.fullmatch(BATCH_ID_RE, value):
        return Ok(value)
    return Err(ClientError("VALIDATION.INPUT", f"{what} {value!r} is not a safe id (letters, digits and _.:- only)",
                               action="See the consumer's Jev batch request schema."))


def _fixture_keys(job: BatchJob) -> tuple[str, ...]:
    return (f"{job.item_id}/{job.candidate_id}/r{job.repeat}",
            f"{job.item_id}/{job.candidate_id}", job.candidate_id, "*")


def _fixture_missing(keys: tuple[str, ...]) -> ClientError:
    return ClientError("FIXTURE.MISSING",
                       f"answers fixture has no entry for {keys[0]} (or {keys[1]}, {keys[2]}, '*')",
                       action=f"Add an entry for {keys[0]} to the answers file.")


def fixture_answer(job: BatchJob, fixture: Mapping[str, Any]) -> Result[Reply, ClientError]:
    keys = _fixture_keys(job)
    entry = next((fixture[key] for key in keys if key in fixture), None)
    if entry is None:
        return Err(_fixture_missing(keys))
    if not isinstance(entry, dict):
        return Err(ClientError("INPUT.MALFORMED", f"answers fixture entry for {keys[0]} must be an object"))
    wire = cast(Mapping[str, Any], entry)
    if BATCH_FIXTURE_ERROR in wire:
        code = str(wire[BATCH_FIXTURE_ERROR])
        return Err(ClientError(code, f"fixture failure {code}"))
    answers = {key: typed_answer(answer) for key, answer in wire.items()}
    if set(answers) != set(job.questions) or any(not _valid_fixture_answer(answer, job.questions[key]) for key, answer in answers.items()):
        return Err(ClientError("DECIDR.RESPONSE_INVALID", "fixture answers do not match the questions"))
    return Ok(Reply(answers, None, False))


def _number(value: object) -> TypeGuard[int | float]:
    try:
        return (type(value) is int or type(value) is float) and math.isfinite(value)
    except OverflowError:  # an int too large for a float
        return False


def _probability(value: object) -> bool:
    return _number(value) and 0 <= value <= 1


def _probabilities(value: object) -> bool:
    return isinstance(value, Mapping) and all(isinstance(key, str) and _probability(item)
                                              for key, item in cast(Mapping[object, object], value).items())


def _valid_fixture_answer(answer: object, question: object) -> bool:
    """Whether a typed fixture answer has the wheel's shape for its question's type."""
    if not isinstance(question, Mapping):
        return False
    shape = cast(Mapping[str, Any], question)
    kind = shape.get("type", "choice")
    # The answer was built from unvalidated fixture JSON, so its fields are checked as plain objects.
    match answer:
        case NoulAnswer(noul):
            return kind == "noul" and _probability(noul)
        case ChoiceAnswer(choice, confidence, probabilities):
            if not (kind == "choice" and isinstance(cast(object, choice), str) and _probability(confidence)
                    and _probabilities(probabilities)):
                return False
            criteria = shape.get("criteria")
            if isinstance(criteria, Mapping) and criteria:
                options = set(cast(Mapping[str, object], criteria))
                if choice not in options or set(probabilities) != options:
                    return False
            return abs(sum(probabilities.values()) - 1) <= 0.01 * max(len(probabilities), 1)
        case ScoreAnswer(score, confidence, legend, probabilities):
            return (kind == "score" and _number(score) and _probability(confidence)
                    and isinstance(cast(object, legend), Mapping) and _probabilities(probabilities))
        case BoxAnswer(top, bottom, left, right, confidence):
            return (kind == "box" and all(_number(side) for side in (top, bottom, left, right))
                    and (confidence is None or _probability(confidence)))
        case _:
            return False


def batch_settings(args: Any, prefix: str, *, check_threshold: Callable[[Any], Any]) -> Result[BatchSettings, ClientError]:
    gate, repeat = getattr(args, "gate", "plan"), getattr(args, "repeat", 1)
    if repeat < 1:
        return Err(ClientError("VALIDATION.INPUT", "--repeat must be at least 1"))
    if not prefix or any(char.isspace() for char in prefix):
        return Err(ClientError("VALIDATION.INPUT", "--request-prefix must be non-empty and contain no whitespace"))
    threshold = check_threshold(getattr(args, "threshold", 0.6))
    if not threshold.ok:
        return Err(from_tool_error(threshold.error))
    return Ok(BatchSettings(gate, repeat, prefix, threshold.value, bool(getattr(args, "dry_run", False))))


def result_line(job: BatchJob, settings: BatchSettings, run_id: str | None, project: str | None,
                result: Result[Reply, ClientError], *, verdict: Callable[..., tuple[str | None, float | None, str | None]] | None = None) -> ResultLine:
    answers: Mapping[str, Any] | None = result.value.answers if isinstance(result, Ok) else None
    decision, confidence, leaning = verdict(job, settings, answers) if verdict else (None, None, None)
    return ResultLine(BATCH_RESULT_SCHEMA, CLIENT_NAME, TOOL_VERSION, run_id,
                      result.value.session_id if isinstance(result, Ok) else None, job.request_id, project, CLIENT_NAME,
                      settings.threshold, decision, confidence, leaning, result.ok, None if isinstance(result, Ok) else result.error)


def _jobs(lines: list[Any], settings: BatchSettings, question_sets: Any,
          make_jobs: Callable[[Any, int, BatchSettings, Any], Any]) -> Result[list[BatchJob], ClientError]:
    """Every job of the request stream, or the first invalid line or repeated request id."""
    jobs: list[BatchJob] = []
    request_ids: set[str] = set()
    for number, line in enumerate(lines, start=1):
        made = make_jobs(line, number, settings, question_sets)
        if not made.ok:
            return Err(from_tool_error(made.error))
        for job in made.value:
            if job.request_id in request_ids:
                return Err(ClientError("VALIDATION.INPUT", f"request {job.request_id} appears twice in the stream",
                                           action="Pair each item, anchor and candidate once; use --repeat for repeats."))
            request_ids.add(job.request_id)
            jobs.append(job)
    return Ok(jobs)


def validate_request_lines(lines: list[Any], settings: BatchSettings, question_sets: Any,
                           make_jobs: Callable[[Any, int, BatchSettings, Any], Any]) -> Result[int, ClientError]:
    """Validate all input before sending; the value is the number of jobs."""
    jobs = _jobs(lines, settings, question_sets, make_jobs)
    return Ok(len(jobs.value)) if isinstance(jobs, Ok) else jobs


def load_answers_fixture(path: str, keyed_by: str, loader: Callable[[str, str], Any], *,
                         validate_envelope: Callable[[Any, str], Any] | None = None) -> Result[Any, ClientError]:
    """Load the consumer's answer fixture using its strict JSON/question schema parser."""
    if not path:
        return Ok(None)
    loaded = loader(path, "answers fixture")
    if not loaded.ok:
        return Err(from_tool_error(loaded.error))
    fixture: Any = loaded.value
    if not isinstance(fixture, dict):
        return Err(ClientError("INPUT.MALFORMED", f"answers fixture must be an object keyed by {keyed_by} (or '*')"))
    if validate_envelope is not None and (error := validate_envelope(fixture, f"answers fixture {path}")) is not None:
        return Err(from_tool_error(error))
    return Ok(cast(dict[str, Any], fixture))


def write_stdout_line(text: str) -> None:
    """Write a UTF-8 JSONL record without Windows text-mode newline translation."""
    buffer = getattr(sys.stdout, "buffer", None)
    if buffer is None:
        sys.stdout.write(text)
        sys.stdout.flush()
    else:
        sys.stdout.flush()
        buffer.write(text.encode("utf-8"))
        buffer.flush()


def json_answers(value: Any) -> Any:
    """``value`` with every typed answer, at any depth, replaced by its JSON wire shape."""
    match value:
        case NoulAnswer(noul):
            return {"type": "noul", "noul": noul}
        case ChoiceAnswer(choice, confidence, probabilities):
            return {"type": "choice", "choice": choice, "confidence": confidence, "probabilities": dict(probabilities)}
        case ScoreAnswer(score, confidence, legend, probabilities):
            return {"type": "score", "score": score, "confidence": confidence,
                    "legend": dict(legend), "probabilities": dict(probabilities)}
        case BoxAnswer(top, bottom, left, right, confidence):
            return {"type": "box", "box": {"top": top, "bottom": bottom, "left": left, "right": right},
                    "confidence": confidence}
        case dict():
            return {key: json_answers(item) for key, item in cast(Record, value).items()}
        case list() | tuple():
            return [json_answers(item) for item in cast(Sequence[Any], value)]
        case _:
            return value


BEARER_RE = re.compile(r"(?i)\b(bearer\s+)[A-Za-z0-9._~+/=-]{16,}")


def redact_secrets(value: Any) -> Any:
    wheel = load_wheel()
    keys: list[str] = wheel.value.provider_keys().get("value", []) if isinstance(wheel, Ok) else []
    import os
    secrets = [os.environ.get(key, "") for key in keys]
    def redact_text(text: str) -> str:
        text = BEARER_RE.sub(r"\1[redacted]", text)
        for secret in secrets:
            if secret:
                text = text.replace(secret, "[redacted]")
        return text
    root: list[Any] = [None]
    pending: list[tuple[Any, Any, Any]] = [(root, 0, value)]
    while pending:
        parent, key, item = pending.pop()
        if isinstance(item, str):
            parent[key] = redact_text(item)
        elif isinstance(item, Mapping):
            source = cast(Mapping[Any, Any], item)
            pairs = [(redact_text(k) if isinstance(k, str) else k, v) for k, v in source.items()]
            child: dict[Any, Any] = dict.fromkeys(k for k, _ in pairs)
            parent[key] = child
            pending.extend((child, k, v) for k, v in pairs)
        elif isinstance(item, (list, tuple)):
            values = cast(Sequence[Any], item)
            child_list: list[Any] = [None] * len(values)
            parent[key] = child_list
            pending.extend((child_list, i, v) for i, v in enumerate(values))
        else:
            parent[key] = item
    return root[0]


def encode_result_line(line: ResultLine) -> str:
    data: dict[str, Any] = dict(line._asdict())
    error = line.error
    if error is not None:
        raw_data: Any = error.data
        detail: Mapping[str, Any] = cast(dict[str, Any], raw_data) if isinstance(raw_data, dict) else {}
        data["error"] = {"id": detail.get("id"), "code": error.code, "message": error.message,
                         "action": error.action, "category": detail.get("category"), "recoverable": error.retryable,
                         "attempts": error.attempts, "data": raw_data}
    return json.dumps(redact_secrets(data), ensure_ascii=False) + "\n"


def run_batch(run: Any | None, jobs: Sequence[BatchJob], settings: BatchSettings, *,
              on_line: Callable[[ResultLine, Mapping[str, Any] | None], object], project: str | None = None,
              fixture: Mapping[str, Any] | None = None, on_request: Callable[[Any], object] | None = None,
              cache: bool | None = None, abort_on: frozenset[str] = frozenset(),
              category_codes: Mapping[str, str] | None = None, repository_root: str = ".",
              consent_what: str = "The request text", verdict: Callable[..., tuple[str | None, float | None, str | None]] | None = None) -> Result[StreamedResult, ClientError]:
    if settings.dry_run:
        return Ok(StreamedResult([]))
    if fixture is not None:
        for job in jobs:
            if not any(key in fixture for key in _fixture_keys(job)):
                return Err(_fixture_missing(_fixture_keys(job)))
        results = [fixture_answer(job, fixture) for job in jobs]
    elif run is None:
        return Err(ClientError("DECIDR.INVALID_OPTION", "run is required"))
    else:
        results = None
        if on_request:
            try:
                for job in jobs:
                    on_request(job.body)
            except Exception as exc:
                return Err(ClientError("DECIDR.ERROR", str(exc)))
    failed: list[ResultLine] = []
    delivered: set[int] = set()
    errors: list[Exception] = []
    cancel: Callable[[], object] | None = run.cancel if run is not None and results is None else None
    def deliver(index: int, result: Result[Reply, ClientError]) -> None:
        if errors or index in delivered:
            return
        delivered.add(index)
        line = result_line(jobs[index], settings, getattr(run, "run_id", None), project, result, verdict=verdict)
        try:
            on_line(line, result.value.answers if isinstance(result, Ok) else None)
        except (Exception, KeyboardInterrupt) as exc:
            errors.append(exc if isinstance(exc, Exception) else ClientError(
                "CANCELED", "interrupted before the command finished", True, "Rerun the command; nothing partial was reported as complete."))
            if cancel is not None:
                cancel()
            return
        if not line.ok:
            failed.append(line)
    if results is None:
        sent = _call_batch_results(run, [job.body for job in jobs], cache=False if settings.repeat > 1 else cache,
                                   on_each=deliver, abort_on=abort_on, category_codes=category_codes,
                                   repository_root=repository_root, consent_what=consent_what)
        if errors:
            return Err(errors[0] if isinstance(errors[0], ClientError) else ClientError("DECIDR.ERROR", str(errors[0])))
        if isinstance(sent, Err):
            return sent
        results = sent.value
    for index, result in enumerate(results):
        deliver(index, result)
        if errors:
            break
    if errors:
        return Err(errors[0] if isinstance(errors[0], ClientError) else ClientError("DECIDR.ERROR", str(errors[0])))
    return Ok(StreamedResult(failed))


def answers_for(lines: Sequence[Mapping[str, Any]]) -> Result[dict[str, dict[str, Any]], ClientError]:
    wheel = load_wheel()
    if isinstance(wheel, Err):
        return wheel
    groups: dict[Any, list[Any]] = {}
    for line in lines:
        if line.get("ok") and line.get("session_id"):
            groups.setdefault(line.get("project"), []).append(line)
    answers: dict[str, dict[str, Any]] = {}
    for project, group in groups.items():
        result: dict[str, Any] = wheel.value.session_rows([line["session_id"] for line in group], agent_role=CLIENT_NAME, project=project)
        if not result.get("ok"):
            return Err(wheel_error(result.get("error", {})))
        rows = result["value"]
        for line in group:
            answers[line["request_id"]] = rows[line["session_id"]]["result"]["value"]["answers"]
    return Ok(answers)
