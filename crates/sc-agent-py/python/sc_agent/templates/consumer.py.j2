---
name: sc-decidr-consumer
version: 0.2.8
format: python
required_variables: [models, general_log, sitr, client_name]
requires:
  cli:
    - name: sc-compose
      minimum_version: "1.8.0"
---
# Generated by sc-decidr 0.2.8; Python >=3.11.
import json
import sc_agent

MODELS = {{ models | tojson }}
AGENT_ROLE = {{ client_name | tojson }}


class Client:
    """One Logger for the app and every wheel call; the app owns its lifecycle."""
    def __init__(self, project, logger=None):
        self.project = project
        self.logger = logger if logger is not None else sc_agent.client_logger(AGENT_ROLE)

    def _result(self, line, codes):
        value = json.loads(line)
        if not value["ok"]:
            error = value["error"]
            error["code"] = codes.get(sc_agent.category(error), codes.get("other"))
        return value

    def send(self, request, model, codes, **options):
        line = sc_agent.send(request, model, self.project, AGENT_ROLE,
                             general_log=self.logger, **options)
        return self._result(line, codes)

    def send_batch(self, requests, model, codes, *, abort_on=(), **options):
        if frozenset(abort_on) not in (frozenset(), frozenset({"auth"}), frozenset({"auth", "quota"})):
            raise ValueError("abort_on must be (), ('auth',), or ('auth', 'quota')")
        token = options.pop("cancel", None) or sc_agent.CancelToken()
        try:
            lines = sc_agent.send_batch(requests, model, self.project, AGENT_ROLE,
                                       general_log=self.logger, cancel=token,
                                       abort_on=list(abort_on), **options)
        except KeyboardInterrupt:
            token.cancel()
            raise
        return [self._result(line, codes) for line in lines]
{% if sitr %}
    def extract(self, language, query, source, captures=None):
        return sc_agent.sitr.run_query(language, query, source, captures=captures,
                                      general_log=self.logger)
{% endif %}
