from typing import Any

class Logger: ...

class CancelToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    def cancelled(self) -> bool: ...

def logger(name: str) -> tuple[Logger | None, str | None]: ...
def send(request: str, model: str, project: str, agent_role: str,
         logger: Logger, provider: str | None = None,
         cancel: CancelToken | None = None, *, timeout_secs: float | None = None,
         keyring_service: str | None = None, keyring_account: str | None = None) -> str: ...
def send_batch(requests: list[str], model: str, project: str, agent_role: str,
               logger: Logger, provider: str | None = None, workers: int | None = None,
               cancel: CancelToken | None = None, *, timeout_secs: float | None = None,
               keyring_service: str | None = None, keyring_account: str | None = None) -> list[str]: ...
def category(error: dict[str, Any] | str) -> str: ...
def retryable(error: dict[str, Any] | str) -> bool: ...
