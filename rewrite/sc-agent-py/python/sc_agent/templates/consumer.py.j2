# Generated by sc-decidr 0.3.0; Python >=3.11.
"""Shared client for the released sc-decidr 0.3.0 Python API.

This module stays importable without the optional wheel. The wheel is loaded only
when a caller makes a decision request.
"""
from __future__ import annotations

import json
from typing import TYPE_CHECKING, Any, Callable, Mapping, Optional, Sequence, Union

if TYPE_CHECKING:
    from sc_agent import Cancel

SC_DECIDR_VERSION = "0.3.0"
# Adapted from plan-anchor fff69b2, decidr_client.py.j2.
CLIENT_NAME = "{{ client_name }}"
MODELS = {{ models | tojson }}
CategoryCodes = Mapping[str, str]
AbortOn = frozenset[str]
BatchItem = str
_LOGGER = None

_ALLOWED_ABORT_ON = (frozenset(), frozenset({"auth"}), frozenset({"auth", "quota"}))


def _failure(code: str, message: str, category: str = "other") -> dict:
    return {"ok": False, "error": {"id": code, "message": message,
            "action": "Read the error and fix the named input or dependency.", "category": category}}


def _validate_abort_on(abort_on: AbortOn) -> Optional[dict]:
    try:
        selected = frozenset(abort_on)
    except (TypeError, ValueError):
        selected = None
    if selected not in _ALLOWED_ABORT_ON:
        return _failure("DECIDR.INVALID_OPTION", "abort_on must be {}, {'auth'}, or {'auth', 'quota'}", "validation")
    return None


def _logger(sc_agent: Any, injected: Any = None) -> dict:
    global _LOGGER
    if injected is not None:
        return {"ok": True, "value": injected}
    if _LOGGER is None:
        created = sc_agent.logger(CLIENT_NAME)
        if not created["ok"]:
            return created
        _LOGGER = created["value"]
    return {"ok": True, "value": _LOGGER}


def _result_category(value: dict) -> Optional[str]:
    error = value.get("error") if isinstance(value, dict) else None
    return error.get("category", "other") if isinstance(error, dict) else None


def _decode(value: dict, category_codes: CategoryCodes) -> tuple[tuple[str, Optional[str]], Optional[str]]:
    category = _result_category(value)
    return (json.dumps(value), category_codes.get(category) if category is not None else None), category


def _cancel_if_selected(category: Optional[str], abort_on: AbortOn, cancel: Any) -> None:
    if category in abort_on and cancel is not None:
        cancel.cancel()


def call(
    request: str,
    *,
    model: str,
    project: str,
    abort_on: AbortOn,
    category_codes: CategoryCodes,
    cancel: "Cancel",
    config_dir: Optional[str] = None,
    general_log: Any = None,
    timeout_secs: Optional[float] = None,
) -> tuple[str, Optional[str]]:
    """Send one decision request and return its result JSON and mapped error code."""
    invalid = _validate_abort_on(abort_on)
    if invalid is not None:
        return (json.dumps(invalid), category_codes.get("validation"))
    try:
        import sc_agent
    except ImportError as exc:
        return (json.dumps(_failure("DEPENDENCY.SC_DECIDR", str(exc))), category_codes.get("other"))
    created = _logger(sc_agent, general_log)
    if not created["ok"]:
        return _decode(created, category_codes)[0]
    general_log = created["value"]
    kwargs = dict(model=model, project=project, agent_role=CLIENT_NAME, cancel=cancel,
                  config_dir=config_dir, general_log=general_log)
    if timeout_secs is not None:
        kwargs["timeout_secs"] = timeout_secs
    try:
        line = sc_agent.send(request, **kwargs)
    except KeyboardInterrupt:
        cancel.cancel()
        line = _failure("decision.cancelled", "interrupted", "cancelled")
    result, category = _decode(line, category_codes)
    _cancel_if_selected(category, abort_on, cancel)
    return result


def call_batch(
    requests: Sequence[BatchItem],
    *,
    model: str,
    project: str,
    abort_on: AbortOn,
    category_codes: CategoryCodes,
    cancel: "Cancel",
    config_dir: Optional[str] = None,
    general_log: Any = None,
    timeout_secs: Optional[float] = None,
    workers: Optional[int] = None,
    on_result: Optional[Callable[[str], None]] = None,
) -> list[tuple[str, Optional[str]]]:
    """Send a batch, preserving wheel result order and mapping each typed category."""
    invalid = _validate_abort_on(abort_on)
    if invalid is not None:
        return [(json.dumps(invalid), category_codes.get("validation")) for _ in requests]
    try:
        import sc_agent
    except ImportError as exc:
        return [(json.dumps(_failure("DEPENDENCY.SC_DECIDR", str(exc))), category_codes.get("other")) for _ in requests]
    def classify(line: dict):
        return _decode(line, category_codes)

    def handle(index: int, line: dict) -> None:
        line = dict(line, index=index)
        _, category = classify(line)
        _cancel_if_selected(category, abort_on, cancel)
        if on_result is not None:
            on_result(json.dumps(line))

    created = _logger(sc_agent, general_log)
    if not created["ok"]:
        return [_decode(created, category_codes)[0] for _ in requests]
    general_log = created["value"]
    kwargs = dict(model=model, project=project, agent_role=CLIENT_NAME, cancel=cancel,
                  on_result=handle, config_dir=config_dir, general_log=general_log)
    if timeout_secs is not None:
        kwargs["timeout_secs"] = timeout_secs
    if workers is not None:
        kwargs["workers"] = workers
    try:
        batch = sc_agent.send_batch(requests, **kwargs)
        lines = [dict(item["result"], index=item["index"]) for item in batch["value"]] if batch["ok"] else [batch for _ in requests]
    except KeyboardInterrupt:
        cancel.cancel()
        lines = [_failure("decision.cancelled", "interrupted", "cancelled") for _ in requests]
    # The wheel returns input order; callbacks above retain finish order.
    return [classify(line)[0] for line in lines]

{% if sitr %}
def extract(language: str, source: str, query: str, *, general_log: Any = None) -> dict:
    """Run the shared syntax query separately from decision prompt authoring."""
    try:
        import sc_agent
    except ImportError as exc:
        return _failure("DEPENDENCY.SC_DECIDR", str(exc))
    created = _logger(sc_agent, general_log)
    if not created["ok"]:
        return created
    general_log = created["value"]
    return sc_agent.sitr.query(language, source, query, general_log=general_log)
{% endif %}
