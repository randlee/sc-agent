      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "The anchor's requirement is: the session schema stores a request once in `messages`, keyed by sha256, and each model reply as a row in `responses` that references it. Read `item.text` and decide whether it commits to that requirement in its own words, as a step, a constraint or a design decision. Acceptable phrasings include: 'a repeated request is stored once in messages by sha256, and each reply is a responses row referencing it'. Do not judge whether anything in the item conflicts with the requirement.",
          "criteria": {
            "yes": "The item commits to the requirement (the session schema stores a request once in `messages`, keyed by sha256, and each model reply as a row in `responses` that references it) as a step, constraint or decision.",
            "no": "The item makes no commitment to the requirement; it is silent, only topical, or commits to something else.",
            "unclear": "The item's wording might be a commitment to the requirement, but it is ambiguous."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that the session schema stores a request once in `messages`, keyed by sha256, and each model reply as a row in `responses` that references it. Does any step, decision or design in `item.text` go against that requirement, such as: storing the full request text on every session or reply row, keying messages by something other than sha256, or putting replies in the same row as the request? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "`anchor.scope` names the work this anchor governs: the session tables or code that stores a request or a model reply. Decide whether the planning item in `item.text` plans or changes that work, directly or as a stated prerequisite. Do not judge compliance or conflict.",
          "criteria": {
            "yes": "The item plans or changes the session tables or code that stores a request or a model reply.",
            "no": "The item plans other work; the session tables or code that stores a request or a model reply is not part of it.",
            "unclear": "It cannot be told from the item text what part of the system it changes."
          }
        }
      }
    },
