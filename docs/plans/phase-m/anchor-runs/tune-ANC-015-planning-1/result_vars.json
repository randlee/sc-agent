      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Is the specific requirement of `anchor.statement` present in `item.text`? The requirement is that a rule that applies to every decidr-based tool is specified only in sc-agent's records; a derivative tool's records do not restate it and give only the tool name and the tool's own behaviour. Examples of presence: 'judge-jev's records name the tool and its own behaviour and point to sc-agent for the logging rule', 'remove the restated rule from the tool's REQ'. Being about the same area, or doing the opposite, is not presence. The anchor is a prohibition; an item that simply never does the forbidden thing but does not say so has not stated it.",
          "criteria": {
            "yes": "The requirement is present in the item text, in any wording.",
            "no": "The requirement is absent from the item text.",
            "unclear": "Something resembling the requirement appears, but whether it is the requirement cannot be determined."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Would doing what `item.text` describes violate the requirement that a rule that applies to every decidr-based tool is specified only in sc-agent's records; a derivative tool's records do not restate it and give only the tool name and the tool's own behaviour? Violations look like: restating, copying or redefining a shared decidr-tool rule (logging, model resolution and the like) in a derivative tool's records. Omitting the requirement, or describing unrelated work, is not a violation.",
          "criteria": {
            "yes": "Doing the described work would violate the requirement.",
            "no": "Doing the described work would not violate the requirement.",
            "unclear": "Whether the described work would violate the requirement cannot be told from the text."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely the REQ/NFR/ADR records of judge-jev, plan-anchor or another sc-agent-based tool? An item that adds or changes REQ/NFR/ADR records of judge-jev, plan-anchor or another sc-agent-based tool is about this subject even if it never mentions the anchor. An item about other components, documents or activities is not.",
          "criteria": {
            "yes": "The item is about the REQ/NFR/ADR records of judge-jev, plan-anchor or another sc-agent-based tool.",
            "no": "The item is about something else and leaves the REQ/NFR/ADR records of judge-jev, plan-anchor or another sc-agent-based tool untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
