      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "The anchor's requirement is: each tool's tables carry their own schema version independent of the core schema version, and no table definition is in the wheel crate sc-agent-py. Read `item.text` and decide whether it commits to that requirement in its own words, as a step, a constraint or a design decision. Acceptable phrasings include: 'judge-jev's tables have their own schema version, separate from the core schema version'. Do not judge whether anything in the item conflicts with the requirement. A bare mention of the topic, or a plan to work on it, without the specific content is no, not unclear. Presence requires the item to state that a tool's tables have a schema version separate from the core version; an sc-agent-py item that merely defines no tables does not state that.",
          "criteria": {
            "yes": "The item commits to the requirement (each tool's tables carry their own schema version independent of the core schema version, and no table definition is in the wheel crate sc-agent-py) as a step, constraint or decision.",
            "no": "The item makes no commitment to the requirement; it is silent, only topical, or commits to something else.",
            "unclear": "The item's wording might be a commitment to the requirement, but it is ambiguous."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that each tool's tables carry their own schema version independent of the core schema version, and no table definition is in the wheel crate sc-agent-py. Does any step, decision or design in `item.text` go against that requirement, such as: versioning a tool's tables with the core schema version, or defining a table in sc-agent-py? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "`anchor.scope` names the work this anchor governs: a tool's table definitions, schema versions, or crates/sc-agent-py. Decide whether the planning item in `item.text` plans or changes that work, directly or as a stated prerequisite. Do not judge compliance or conflict. An item that only documents, describes, reviews or plans this subject still touches it.",
          "criteria": {
            "yes": "The item plans or changes a tool's table definitions, schema versions, or crates/sc-agent-py.",
            "no": "The item plans other work; a tool's table definitions, schema versions, or crates/sc-agent-py is not part of it.",
            "unclear": "It cannot be told from the item text what part of the system it changes."
          }
        }
      }
    },
