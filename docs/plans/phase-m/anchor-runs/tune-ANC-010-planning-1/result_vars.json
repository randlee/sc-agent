      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Does `item.text` explicitly state or plan what `anchor.statement` requires: logic is not copied and pasted between files or tools; shared logic lives in one place both use? The anchor is a prohibition; an item that simply never does the forbidden thing but does not say so has not stated it. Count it only when the item's text contains that specific content, for example: 'both tools call the shared client generated from the template', 'move the duplicated parser into the shared module'. A mention of the topic without that content does not count. Judge presence only, not conflict.",
          "criteria": {
            "yes": "The item explicitly states or plans that logic is not copied and pasted between files or tools; shared logic lives in one place both use, in any wording, for example: 'both tools call the shared client generated from the template', 'move the duplicated parser into the shared module'.",
            "no": "The item does not state that logic is not copied and pasted between files or tools; shared logic lives in one place both use: it is silent about it or only mentions the topic.",
            "unclear": "The item mentions something close to this requirement, but it cannot be told whether it states the requirement itself."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that logic is not copied and pasted between files or tools; shared logic lives in one place both use. Does any step, decision or design in `item.text` go against that requirement, such as: copying, pasting, vendoring or duplicating a function or parser from one tool or file into another? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely code in judge-jev, plan-anchor or the client template both tools use? An item that adds or changes code in judge-jev, plan-anchor or the shared client template is about this subject even if it never mentions the anchor. An item about other components, documents or activities is not.",
          "criteria": {
            "yes": "The item is about code in judge-jev, plan-anchor or the client template both tools use.",
            "no": "The item is about something else and leaves code in judge-jev, plan-anchor or the client template both tools use untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
