    "addressed": {
     "type": "choice",
     "instructions": "The anchor requires: related values that are passed to several methods are grouped in one struct that replaces those repeated parameters. Does `item.text` plan exactly that: name or describe a struct (new or existing) that carries a group of related values in place of separate parameters on more than one method? A new method that takes an existing grouping struct instead of the separate values also counts. General wishes to tidy signatures, a single method with its own parameters, or a struct used by only one method do not count. Judge presence only, not conflict.",
     "criteria": {
      "yes": "The item plans that several methods take one struct in place of a repeated group of related parameters (for example: 'send, stream and batch take one RetryPolicy instead of max_attempts, base_wait, max_wait').",
      "no": "The item does not plan a struct replacing a repeated parameter group across methods: it is silent, only mentions tidying, concerns one method only, or keeps or reintroduces repeated parameters.",
      "unclear": "The item mentions a struct or grouping, but it cannot be told whether it replaces parameters repeated across several methods."
     }
    },
    "contradicted": {
     "criteria": {
      "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
      "unclear": "A step could be read as going against the requirement, but it is ambiguous.",
      "yes": "A step, decision or design in the item goes against the requirement."
     },
     "instructions": "The anchor requires that related values passed to several methods are grouped into one struct that replaces those repeated parameters. Does any step, decision or design in `item.text` go against that requirement, such as: adding new methods that each repeat the same group of related parameters instead of grouping them, or splitting an existing parameter struct back into repeated parameters? An item that is silent about the requirement does not go against it.",
     "type": "choice"
    },
    "relevant": {
