      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Is the specific requirement of `anchor.statement` present in `item.text`? The requirement is that sc-agent imposes no request input size limit of its own beyond the selected model's context. Examples of presence: 'no byte cap is added', 'requests up to the model context are sent', 'input is limited only by the model context'. Being about the same area, or doing the opposite, is not presence. The anchor is a prohibition; an item that simply never does the forbidden thing but does not say so has not stated it. A bare mention of the topic, or a plan to work on it, without the specific content is no, not unclear.",
          "criteria": {
            "yes": "The requirement is present in the item text, in any wording.",
            "no": "The requirement is absent from the item text.",
            "unclear": "Something resembling the requirement appears, but whether it is the requirement cannot be determined."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Would doing what `item.text` describes violate the requirement that sc-agent imposes no request input size limit of its own beyond the selected model's context? Violations look like: adding a byte, character or token cap on request input below the model's context, rejecting or truncating large requests by sc-agent's own limit. Omitting the requirement, or describing unrelated work, is not a violation.",
          "criteria": {
            "yes": "Doing the described work would violate the requirement.",
            "no": "Doing the described work would not violate the requirement.",
            "unclear": "Whether the described work would violate the requirement cannot be told from the text."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely request or record size checks in sc-agent, or handling of an sc-observability size error? An item that adds or changes a request size check, a record size check, or handling of an sc-observability size error is about this subject even if it never mentions the anchor. An item about other components or activities is not. An item that only documents, describes, reviews or plans this subject still touches it.",
          "criteria": {
            "yes": "The item is about request or record size checks in sc-agent, or handling of an sc-observability size error.",
            "no": "The item is about something else and leaves request or record size checks in sc-agent, or handling of an sc-observability size error untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
