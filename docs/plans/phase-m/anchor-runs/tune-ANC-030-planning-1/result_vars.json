      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Is the specific requirement of `anchor.statement` present in `item.text`? The requirement is that retry and holdoff code takes its waits, limits and busy and quota rules as parameters from the calling layer and contains no provider name, host or status-code table. Examples of presence: 'the retry helper takes its waits, limits and busy and quota rules as parameters from the provider crate'. Being about the same area, or doing the opposite, is not presence.",
          "criteria": {
            "yes": "The requirement is present in the item text, in any wording.",
            "no": "The requirement is absent from the item text.",
            "unclear": "Something resembling the requirement appears, but whether it is the requirement cannot be determined."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Does `item.text` plan something that breaks `anchor.statement` (retry and holdoff code takes its waits, limits and busy and quota rules as parameters from the calling layer and contains no provider name, host or status-code table)? Breaking it means, for example: hard-coding provider names, hosts, status codes (such as 429 or 529) or wait values inside the retry or holdoff code. Silence about the requirement is not a conflict, and an item that merely does not mention it answers no. Judge conflict only.",
          "criteria": {
            "yes": "The item plans something that breaks the requirement, for example: hard-coding provider names, hosts, status codes (such as 429 or 529) or wait values inside the retry or holdoff code.",
            "no": "Nothing in the item breaks the requirement, whether or not the item mentions it.",
            "unclear": "The item plans something that might break the requirement, but the text does not settle it."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "`anchor.scope` names the work this anchor governs: retry, resend, backoff or holdoff code. Decide whether the planning item in `item.text` plans or changes that work, directly or as a stated prerequisite. Do not judge compliance or conflict.",
          "criteria": {
            "yes": "The item plans or changes retry, resend, backoff or holdoff code.",
            "no": "The item plans other work; retry, resend, backoff or holdoff code is not part of it.",
            "unclear": "It cannot be told from the item text what part of the system it changes."
          }
        }
      }
    },
