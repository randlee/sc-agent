      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Does `item.text` explicitly state or plan what `anchor.statement` requires: a cache hit is decided by the request sha256 and the model alone, and run_id is not part of the cache key? Count it only when the item's text contains that specific content, for example: 'the cache is looked up by (request_sha256, model) only'. A mention of the topic without that content does not count. Judge presence only, not conflict.",
          "criteria": {
            "yes": "The item explicitly states or plans that a cache hit is decided by the request sha256 and the model alone, and run_id is not part of the cache key, in any wording, for example: 'the cache is looked up by (request_sha256, model) only'.",
            "no": "The item does not state that a cache hit is decided by the request sha256 and the model alone, and run_id is not part of the cache key: it is silent about it or only mentions the topic.",
            "unclear": "The item mentions something close to this requirement, but it cannot be told whether it states the requirement itself."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that a cache hit is decided by the request sha256 and the model alone, and run_id is not part of the cache key. Does any step, decision or design in `item.text` go against that requirement, such as: including run_id, session id, timestamps or other fields in the cache key, or keying the cache without the model? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely the result cache, cache keys or run ids? An item that adds or changes the result cache, cache keys or run ids is about this subject even if it never mentions the anchor. An item about other components, documents or activities is not.",
          "criteria": {
            "yes": "The item is about the result cache, cache keys or run ids.",
            "no": "The item is about something else and leaves the result cache, cache keys or run ids untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
