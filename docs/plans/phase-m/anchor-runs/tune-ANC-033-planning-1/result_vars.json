      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Does `item.text` state the specific outcome that `anchor.statement` requires, for the specific case it names? Covering only a neighbouring case, only the general topic, or the opposite outcome does not count. Judge presence of the required outcome only.",
          "criteria": {
            "yes": "The item states the required outcome for the case the anchor names.",
            "no": "The item does not state that outcome for that case (silent, neighbouring case only, generic, or a different outcome).",
            "unclear": "The item hints at the outcome but it cannot be told whether it is stated for the named case."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Does `item.text` state an outcome for the case named in `anchor.statement` that differs from the outcome the statement requires, including refusing or blocking that case? Silence, or covering only other cases, is not a contradiction. Judge conflict only.",
          "criteria": {
            "yes": "For the case the anchor names, the item states a different outcome, or refuses the case.",
            "no": "The item states the required outcome, or is silent about the named case.",
            "unclear": "The item's outcome for the named case is ambiguous."
          }
        },
        "relevant": {
          "criteria": {
            "no": "The item is about a different part of the system or a different activity, and completing it would neither follow nor break the anchor.",
            "unclear": "The item text is too vague to tell what part of the system it touches.",
            "yes": "The item plans, changes, or depends on the thing the anchor statement is about, directly or as a clear prerequisite."
          },
          "instructions": "The state holds one planning item (`item.title`, `item.text`) and one anchor: a directive the user stated verbatim in `anchor.statement`, with the area it governs in `anchor.scope`. Does the work described in `item.text` touch the subject that `anchor.statement` talks about? Judge overlap of subject matter only. Do not judge whether the item obeys the anchor.",
          "type": "choice"
        }
      }
    },
