      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Does `item.text` itself state the specific requirement in `anchor.statement` (the same limit, starting point, method or constraint) as something the item does or keeps? Naming the topic, changing the same file, or referring to supported values without stating the required one does not count. Judge presence of the requirement only, not conflict.",
          "criteria": {
            "yes": "The item text itself states the directive's specific requirement (for example the exact limit, starting point, method or constraint), as a step, constraint or decision.",
            "no": "The item text does not state the directive's specific requirement, even if it mentions the same topic or changes the same file.",
            "unclear": "The item text partly states the requirement but leaves out a detail needed to tell whether the directive is carried."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Does `item.text` plan or declare something that `anchor.statement` rules out: a different value, a looser or reversed constraint, a support claim outside what the directive allows, or an exception the directive does not grant? Silence about the directive is not a contradiction. Judge conflict only.",
          "criteria": {
            "yes": "The item text states a plan, decision, support claim or exception that cannot be reconciled with the directive.",
            "no": "Nothing in the item text conflicts with the directive, whether or not the directive is mentioned.",
            "unclear": "The item text might or might not conflict with the directive; it is too ambiguous to tell."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "The state holds one planning item (`item.title`, `item.text`) and one anchor: a directive in `anchor.statement` with the area it governs in `anchor.scope`. Does the work in `item.text` touch the subject of `anchor.statement` or anything listed in `anchor.scope`? An item that edits or changes something `anchor.scope` names is relevant even when it never mentions the directive. Judge subject overlap only, not obedience.",
          "criteria": {
            "yes": "The item plans, changes, or depends on the thing the anchor statement or scope names, directly or as a clear prerequisite.",
            "no": "The item is about a different part of the system or activity; completing it would neither follow nor break the anchor.",
            "unclear": "The item text is too vague to tell what part of the system it touches."
          }
        }
      }
    },
