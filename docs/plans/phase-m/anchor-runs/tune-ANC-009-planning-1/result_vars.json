      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Is the specific requirement of `anchor.statement` present in `item.text`? The requirement is that the model table accepts extra model rows from config in addition to its hard-coded rows. Examples of presence: 'a model row added under [models] in the config is usable', 'config rows are merged with the built-in rows'. Being about the same area, or doing the opposite, is not presence.",
          "criteria": {
            "yes": "The requirement is present in the item text, in any wording.",
            "no": "The requirement is absent from the item text.",
            "unclear": "Something resembling the requirement appears, but whether it is the requirement cannot be determined."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Would doing what `item.text` describes violate the requirement that the model table accepts extra model rows from config in addition to its hard-coded rows? Violations look like: making the model table hard-coded only, requiring a code edit or release to add a model, or having config rows replace all built-in rows. Omitting the requirement, or describing unrelated work, is not a violation.",
          "criteria": {
            "yes": "Doing the described work would violate the requirement.",
            "no": "Doing the described work would not violate the requirement.",
            "unclear": "Whether the described work would violate the requirement cannot be told from the text."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely the sc-agent model table or model configuration? An item that adds or changes the model table or model configuration in sc-agent is about this subject even if it never mentions the anchor. An item about other components, documents or activities is not.",
          "criteria": {
            "yes": "The item is about the sc-agent model table or model configuration.",
            "no": "The item is about something else and leaves the sc-agent model table or model configuration untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
