      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Does `item.text` explicitly state or plan what `anchor.statement` requires: related values passed to several methods are grouped into one struct that replaces those repeated parameters? Count it only when the item's text contains that specific content, for example: 'the methods that took endpoint, model and timeout now take one ProviderTarget struct', 'group the repeated parameters into a struct'. A mention of the topic without that content does not count. Judge presence only, not conflict.",
          "criteria": {
            "yes": "The item explicitly states or plans that related values passed to several methods are grouped into one struct that replaces those repeated parameters, in any wording, for example: 'the methods that took endpoint, model and timeout now take one ProviderTarget struct', 'group the repeated parameters into a struct'.",
            "no": "The item does not state that related values passed to several methods are grouped into one struct that replaces those repeated parameters: it is silent about it or only mentions the topic.",
            "unclear": "The item mentions something close to this requirement, but it cannot be told whether it states the requirement itself."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that related values passed to several methods are grouped into one struct that replaces those repeated parameters. Does any step, decision or design in `item.text` go against that requirement, such as: adding new methods that each repeat the same group of related parameters instead of grouping them, or splitting an existing parameter struct back into repeated parameters? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely function or method signatures in sc-agent code? An item that adds or changes function or method signatures in sc-agent code is about this subject even if it never mentions the anchor. An item about other components, documents or activities is not.",
          "criteria": {
            "yes": "The item is about function or method signatures in sc-agent code.",
            "no": "The item is about something else and leaves function or method signatures in sc-agent code untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
