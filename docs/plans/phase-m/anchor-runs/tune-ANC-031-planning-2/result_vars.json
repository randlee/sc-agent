      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "The anchor's requirement is: judge-jev, plan-anchor and every other sc-agent-based tool store their results in the repository's SQLite database, not in JSON or JSONL result files. Read `item.text` and decide whether it commits to that requirement in its own words, as a step, a constraint or a design decision. Acceptable phrasings include: 'judge-jev writes its quality results to the repository SQLite database'. Do not judge whether anything in the item conflicts with the requirement. A bare mention of the topic, or a plan to work on it, without the specific content is no, not unclear. Writing results to the SQLite database counts as presence even when the tool also prints output or renders a report from it.",
          "criteria": {
            "yes": "The item commits to the requirement (judge-jev, plan-anchor and every other sc-agent-based tool store their results in the repository's SQLite database, not in JSON or JSONL result files) as a step, constraint or decision.",
            "no": "The item makes no commitment to the requirement; it is silent, only topical, or commits to something else.",
            "unclear": "The item's wording might be a commitment to the requirement, but it is ambiguous."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that judge-jev, plan-anchor and every other sc-agent-based tool store their results in the repository's SQLite database, not in JSON or JSONL result files. Does any step, decision or design in `item.text` go against that requirement, such as: storing tool results in JSON or JSONL files (for example anchor-runs/<run>.json) as the result store? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "`anchor.scope` names the work this anchor governs: how judge-jev, plan-anchor or another sc-agent-based tool stores its results. Decide whether the planning item in `item.text` plans or changes that work, directly or as a stated prerequisite. Do not judge compliance or conflict. An item that only documents, describes, reviews or plans this subject still touches it.",
          "criteria": {
            "yes": "The item plans or changes how judge-jev, plan-anchor or another sc-agent-based tool stores its results.",
            "no": "The item plans other work; how judge-jev, plan-anchor or another sc-agent-based tool stores its results is not part of it.",
            "unclear": "It cannot be told from the item text what part of the system it changes."
          }
        }
      }
    },
