      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Is the specific requirement of `anchor.statement` present in `item.text`? The requirement is that until SQLite schema 1.0, the reader reads only the record schema version the code writes and contains no reader for any older version. Examples of presence: 'the reader accepts only the version the writer emits', 'any other version is an error', 'no fallback for old versions'. Being about the same area, or doing the opposite, is not presence. The anchor is a prohibition; an item that simply never does the forbidden thing but does not say so has not stated it.",
          "criteria": {
            "yes": "The requirement is present in the item text, in any wording.",
            "no": "The requirement is absent from the item text.",
            "unclear": "Something resembling the requirement appears, but whether it is the requirement cannot be determined."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Does `item.text` plan something that breaks `anchor.statement` (until SQLite schema 1.0, the reader reads only the record schema version the code writes and contains no reader for any older version)? Breaking it means, for example: adding a fallback, legacy or v1 reader, keeping a compatibility shim that loads older record versions, or migrating old records on read. Silence about the requirement is not a conflict, and an item that merely does not mention it answers no. Judge conflict only.",
          "criteria": {
            "yes": "The item plans something that breaks the requirement, for example: adding a fallback, legacy or v1 reader, keeping a compatibility shim that loads older record versions, or migrating old records on read.",
            "no": "Nothing in the item breaks the requirement, whether or not the item mentions it.",
            "unclear": "The item plans something that might break the requirement, but the text does not settle it."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "`anchor.scope` names the work this anchor governs: code that reads batch result lines, session rows or run records and which record schema versions it accepts. Decide whether the planning item in `item.text` plans or changes that work, directly or as a stated prerequisite. Do not judge compliance or conflict.",
          "criteria": {
            "yes": "The item plans or changes code that reads batch result lines, session rows or run records and which record schema versions it accepts.",
            "no": "The item plans other work; code that reads batch result lines, session rows or run records and which record schema versions it accepts is not part of it.",
            "unclear": "It cannot be told from the item text what part of the system it changes."
          }
        }
      }
    },
