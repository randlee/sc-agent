      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "The anchor's requirement is: sc-agent's integration tests are its unit tests run against live agents, triggered manually. Read `item.text` and decide whether it commits to that requirement in its own words, as a step, a constraint or a design decision. Acceptable phrasings include: 'the live job reruns the existing unit tests against real providers and is started with workflow_dispatch only'. Do not judge whether anything in the item conflicts with the requirement. A bare mention of the topic, or a plan to work on it, without the specific content is no, not unclear. An item stating that a unit test can be run against a live provider through a manual switch counts as presence.",
          "criteria": {
            "yes": "The item commits to the requirement (sc-agent's integration tests are its unit tests run against live agents, triggered manually) as a step, constraint or decision.",
            "no": "The item makes no commitment to the requirement; it is silent, only topical, or commits to something else.",
            "unclear": "The item's wording might be a commitment to the requirement, but it is ambiguous."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that sc-agent's integration tests are its unit tests run against live agents, triggered manually. Does any step, decision or design in `item.text` go against that requirement, such as: a separate integration test suite, or live tests that run automatically on pull requests, pushes or a schedule? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "`anchor.scope` names the work this anchor governs: live-provider tests, test selection for live runs, or CI workflows under .github/workflows. Decide whether the planning item in `item.text` plans or changes that work, directly or as a stated prerequisite. Do not judge compliance or conflict. An item that only documents, describes, reviews or plans this subject still touches it.",
          "criteria": {
            "yes": "The item plans or changes live-provider tests, test selection for live runs, or CI workflows under .github/workflows.",
            "no": "The item plans other work; live-provider tests, test selection for live runs, or CI workflows under .github/workflows is not part of it.",
            "unclear": "It cannot be told from the item text what part of the system it changes."
          }
        }
      }
    },
