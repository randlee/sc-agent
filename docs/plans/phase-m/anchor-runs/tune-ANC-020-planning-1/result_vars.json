      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Does `item.text` explicitly state or plan what `anchor.statement` requires: when a caller passes its own sc_observability Logger into an sc-agent wheel call, sc-agent builds no second Logger for that log? The anchor is a prohibition; an item that simply never does the forbidden thing but does not say so has not stated it. Count it only when the item's text contains that specific content, for example: 'when general_log= is given, the wheel writes to that logger and builds no other'. A mention of the topic without that content does not count. Judge presence only, not conflict.",
          "criteria": {
            "yes": "The item explicitly states or plans that when a caller passes its own sc_observability Logger into an sc-agent wheel call, sc-agent builds no second Logger for that log, in any wording, for example: 'when general_log= is given, the wheel writes to that logger and builds no other'.",
            "no": "The item does not state that when a caller passes its own sc_observability Logger into an sc-agent wheel call, sc-agent builds no second Logger for that log: it is silent about it or only mentions the topic.",
            "unclear": "The item mentions something close to this requirement, but it cannot be told whether it states the requirement itself."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "The anchor requires that when a caller passes its own sc_observability Logger into an sc-agent wheel call, sc-agent builds no second Logger for that log. Does any step, decision or design in `item.text` go against that requirement, such as: building a Logger (LoggerBuilder, python logging or another) for the same log even when the caller injected one? An item that is silent about the requirement does not go against it.",
          "criteria": {
            "yes": "A step, decision or design in the item goes against the requirement.",
            "no": "No step, decision or design in the item goes against the requirement; silence counts as no.",
            "unclear": "A step could be read as going against the requirement, but it is ambiguous."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely crates/sc-agent-py or any code path that accepts an injected logger (general_log=, session_log=)? An item that touches crates/sc-agent-py or any code path that accepts an injected logger (general_log=, session_log=) is about this subject even if it never mentions the anchor. An item about other components, documents or activities is not.",
          "criteria": {
            "yes": "The item is about crates/sc-agent-py or any code path that accepts an injected logger (general_log=, session_log=).",
            "no": "The item is about something else and leaves crates/sc-agent-py or any code path that accepts an injected logger (general_log=, session_log=) untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
