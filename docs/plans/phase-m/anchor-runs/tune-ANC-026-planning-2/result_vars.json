      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Is the specific requirement of `anchor.statement` present in `item.text`? The requirement is that every core table's SQL is defined in sc-agent-schema and nowhere else. Examples of presence: 'the responses table's CREATE TABLE text is added in sc-agent-schema and used from there'. Being about the same area, or doing the opposite, is not presence. A bare mention of the topic, or a plan to work on it, without the specific content is no, not unclear. Using a core table's SQL constant from sc-agent-schema counts as presence.",
          "criteria": {
            "yes": "The requirement is present in the item text, in any wording.",
            "no": "The requirement is absent from the item text.",
            "unclear": "Something resembling the requirement appears, but whether it is the requirement cannot be determined."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Would doing what `item.text` describes violate the requirement that every core table's SQL is defined in sc-agent-schema and nowhere else? Violations look like: defining or duplicating a core table's CREATE TABLE or other SQL definition in a crate other than sc-agent-schema. Omitting the requirement, or describing unrelated work, is not a violation. A tool's own table (for example judge-jev's results table) is not a core table; defining it outside sc-agent-schema does not break this requirement.",
          "criteria": {
            "yes": "Doing the described work would violate the requirement.",
            "no": "Doing the described work would not violate the requirement.",
            "unclear": "Whether the described work would violate the requirement cannot be told from the text."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely SQL table definitions anywhere in the workspace? An item that adds or changes SQL table definitions anywhere in the workspace is about this subject even if it never mentions the anchor. An item about other components or activities is not. An item that only documents, describes, reviews or plans this subject still touches it.",
          "criteria": {
            "yes": "The item is about SQL table definitions anywhere in the workspace.",
            "no": "The item is about something else and leaves SQL table definitions anywhere in the workspace untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
