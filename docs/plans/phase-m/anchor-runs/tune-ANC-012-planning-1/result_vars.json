      "questions": {
        "addressed": {
          "type": "choice",
          "instructions": "Is the specific requirement of `anchor.statement` present in `item.text`? The requirement is that decision providers implement one decision trait with one implementation per wire format (Jev TypeSafe systemone, OpenAI-compatible, Anthropic-compatible), and every provider speaking a wire format uses that format's implementation. Examples of presence: 'the new provider is a row naming the OpenAI-compatible wire format', 'reuse the Anthropic-compatible implementation', 'one Decision trait impl per wire format'. Being about the same area, or doing the opposite, is not presence.",
          "criteria": {
            "yes": "The requirement is present in the item text, in any wording.",
            "no": "The requirement is absent from the item text.",
            "unclear": "Something resembling the requirement appears, but whether it is the requirement cannot be determined."
          }
        },
        "contradicted": {
          "type": "choice",
          "instructions": "Would doing what `item.text` describes violate the requirement that decision providers implement one decision trait with one implementation per wire format (Jev TypeSafe systemone, OpenAI-compatible, Anthropic-compatible), and every provider speaking a wire format uses that format's implementation? Violations look like: writing a provider-specific decision implementation that duplicates a wire format's request code, or hard-coding a new provider instead of reusing its format's implementation. Omitting the requirement, or describing unrelated work, is not a violation.",
          "criteria": {
            "yes": "Doing the described work would violate the requirement.",
            "no": "Doing the described work would not violate the requirement.",
            "unclear": "Whether the described work would violate the requirement cannot be told from the text."
          }
        },
        "relevant": {
          "type": "choice",
          "instructions": "Is `item.text` about the same subject as `anchor.statement`, namely sc-agent decision providers, provider dispatch or the provider table? An item that adds or changes decision providers, provider dispatch or the provider table in sc-agent is about this subject even if it never mentions the anchor. An item about other components, documents or activities is not.",
          "criteria": {
            "yes": "The item is about sc-agent decision providers, provider dispatch or the provider table.",
            "no": "The item is about something else and leaves sc-agent decision providers, provider dispatch or the provider table untouched.",
            "unclear": "The item names this area only vaguely, so overlap cannot be decided."
          }
        }
      }
    },
