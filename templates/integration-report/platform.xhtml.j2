---
required_variables:
  - run_id
  - platform
  - status
  - generated_at
  - prerelease_tag
  - source_commit
  - artifacts
  - results
defaults: {}
metadata:
  purpose: Live sc-agent prerelease platform report consumed by publication preflight
---
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"><head><title>sc-agent integration {{ run_id }}</title>
<meta http-equiv="Content-Type" content="application/xhtml+xml; charset=UTF-8" />
<meta name="integration-generated-at" content="{{ generated_at }}" />
<style type="text/css">body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#1b1b1b;margin:1.5rem;line-height:1.45}h1{font-size:1.25rem;margin:0 0 .25rem}h2{font-size:1.05rem;margin:1.5rem 0 .5rem;border-bottom:1px solid #d5d9de;padding-bottom:.2rem}h3{font-size:1rem;margin:1.2rem 0 .3rem}h4{font-size:.85rem;margin:.8rem 0 .2rem;color:#555;text-transform:uppercase;letter-spacing:.03em}p.meta{margin:.2rem 0;color:#555}table{border-collapse:collapse;width:100%;margin:.4rem 0}th,td{border:1px solid #d5d9de;padding:.35rem .5rem;text-align:left;vertical-align:top}th{background:#f3f5f7;font-weight:600;color:#555;font-size:.85em}table.facts{width:auto;min-width:24rem}table.facts th{width:11rem;font-weight:600}pre{margin:0;white-space:pre-wrap;word-break:break-word;font-size:.82em;background:#f7f9fa;padding:.4rem .5rem;border:1px solid #e3e3e3;max-height:24rem;overflow:auto}code{white-space:pre-wrap;word-break:break-all}.verdict{font-weight:700;padding:.1rem .5rem;border-radius:.25rem}.pass{background:#e8f5e9;color:#1a7f37}.fail{background:#ffebee;color:#c62828}a{color:#0b57d0}dl{margin:.5rem 0}dt{color:#555;font-size:.85em}dd{margin:0 0 .4rem}</style>
</head><body>
<h1>sc-agent integration <span class="verdict {{ status | lower }}">{{ status }}</span></h1>
<table class="facts"><tbody>
<tr><th scope="row">Run</th><td>{{ run_id }}</td></tr>
<tr><th scope="row">Platform</th><td>{{ platform }}</td></tr>
<tr><th scope="row">Prerelease</th><td>{{ prerelease_tag }}</td></tr>
<tr><th scope="row">Tested source</th><td><code>{{ source_commit }}</code></td></tr>
<tr><th scope="row">Recorded</th><td>{{ generated_at }}</td></tr>
</tbody></table>
<h2>Checksum-verified installed artifacts</h2>
<table><thead><tr><th scope="col">Archive or wheel</th><th scope="col">SHA-256</th></tr></thead><tbody>
{% for artifact in artifacts %}<tr><td>{{ artifact.name }}</td><td><code>{{ artifact.sha256 }}</code></td></tr>
{% endfor %}</tbody></table>
<h2>Live provider cases</h2>
<table><thead><tr><th scope="col">Case</th><th scope="col">Status</th><th scope="col">Sanitized result</th><th scope="col">Session</th><th scope="col">Artifact SHA-256</th></tr></thead><tbody>
{% for result in results %}<tr><td>{{ result.case_id }}</td><td><span class="verdict {{ result.status | lower }}">{{ result.status }}</span></td><td>{{ result.reason }}</td><td><code>{{ result.session_id | default("") }}</code></td><td><code>{{ result.artifact_sha256 }}</code></td></tr>
{% endfor %}</tbody></table>
<p class="meta">Every required case must pass. FAIL, SKIP and missing cases cannot satisfy publication preflight. Credentials and raw provider output are excluded from this report.</p>
</body></html>
